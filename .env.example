# Required at deployment time. Use your actual RAM role ARN and ACME account email.
FC_CERTBOT_ROLE_ARN=acs:ram::YOUR_ACCOUNT_ID:role/YOUR_ROLE_NAME
CERTBOT_EMAIL=you@example.com

# Optional deployment settings
FC_CERTBOT_ACCESS=default
CERT_GENERATOR_FUNCTION_NAME=cert-generator
FC_DOMAIN_MANAGER_FUNCTION_NAME=fc-domain-manager
